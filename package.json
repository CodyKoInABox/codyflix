{
  "name": "codyflix",
  "version": "1.0.0",
  "private": true,
  "description": "A static Netflix-style browser for Cody Ko and the YouTube channels around him.",
  "scripts": {
    "dev": "next dev",
    "fetch-catalog": "node scripts/fetch-catalog.mjs",
    "build": "node scripts/fetch-catalog.mjs && next build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 121",
    "safari >= 17.4",
    "ios_saf >= 17.4"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
